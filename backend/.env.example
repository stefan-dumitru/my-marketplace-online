DATABASE_URL=postgresql+psycopg://marketplace:marketplace@localhost:5433/marketplace

# Get a free API key at https://resend.com — verification/notification emails won't send without it.
RESEND_API_KEY=
# Resend's sandbox sender only delivers to the email on your own Resend account, until a custom domain is verified.
EMAIL_FROM=onboarding@resend.dev

FRONTEND_BASE_URL=http://localhost:5173

# Cloudflare R2: Account -> R2 -> create a bucket, then Manage API Tokens -> create one scoped
# to that bucket with "Object Read & Write" permission.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# The bucket needs public read access (enable the r2.dev public URL for it, or a custom domain)
# since product images are public catalog content. Example: https://pub-xxxx.r2.dev
R2_PUBLIC_BASE_URL=
